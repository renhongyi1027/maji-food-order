.login-container {
  padding: 60rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #e8f4ec 0%, #f7f7f7 100%);
  position: relative;
}

/* 移除了背景图片和蒙层——微信小程序不支持 WXSS 本地背景图 */
.login-container .logo-area,
.login-container .form-area {
  position: relative;
  z-index: 1;
}

.logo-area {
  margin-top: 100rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  width: 160rpx;
  height: 160rpx;
  background: #07c160;
  border-radius: 40rpx;
  margin: 0 auto 20rpx;
  color: #fff;
  font-size: 72rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  color: #333;
}

.welcome {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.form-area {
  margin-top: 40rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.input {
  background: #f7f7f7;
  height: 90rpx;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.password-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input {
  flex: 1;
  padding-right: 100rpx;
}

.password-toggle {
  position: absolute;
  right: 0;
  height: 100%;
  width: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.eye-icon {
  font-size: 36rpx;
  color: #666;
}

.login-btn {
  background: #07c160;
  color: #fff;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-weight: bold;
  margin-top: 60rpx;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 30rpx;
}